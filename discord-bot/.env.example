# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# Bot token from the Discord Developer Portal (Bot page -> Reset Token)
DISCORD_TOKEN=

# Channel IDs the bot watches, separated by commas. Leave blank to watch every channel it can see.
# (Discord: Settings -> Advanced -> Developer Mode ON, then right-click a channel -> Copy Channel ID)
CHANNEL_IDS=

# Max characters per posted part. 2000 is Discord's limit for bots.
MESSAGE_LIMIT=2000

# Seconds to wait between parts.
DELAY_SECONDS=2.5

# Add "Part 1/3" labels to each part (true/false).
PART_LABELS=true

# Delete the original message.txt post after splitting (true/false).
# Needs the "Manage Messages" permission.
DELETE_ORIGINAL=false

# Skip files bigger than this many KB (stops huge files from flooding a channel).
MAX_FILE_KB=100
